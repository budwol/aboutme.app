{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": [],
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@assets/*": ["assets/*"],
      "@components/*": ["src/components/*"],
      "@constants/*": ["src/constants/*"],
      "@utils/*": ["src/utils/*"],
      "wna-logger": ["src/utils/logger.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
