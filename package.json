{
  "name": "about-me",
  "main": "expo-router/entry",
  "packageManager": "npm@11.5.2",
  "version": "1.2.0",
  "scripts": {
    "clean-install": "rm -rf node_modules && rm package-lock.json && npm install",
    "ci:local": "./scripts/ci-local.sh",
    "deploy:container": "./scripts/deploy-container.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:web": "npm run deploy:container && echo deploy:web done.",
    "export:web": "node ./scripts/sync-web-app-data.cjs && npm run ci:local && node ./scripts/sync-web-app-data.cjs && node ./scripts/generate-resume-pdf.cjs && npx expo export -p web -c && node ./scripts/inject-web-shell.cjs",
    "fix:prettier": "prettier --write .",
    "generate:resume-pdf": "node ./scripts/generate-resume-pdf.cjs",
    "init": "./init.sh",
    "lint": "eslint ./src --no-cache",
    "lint-fix": "eslint ./src --fix --no-cache",
    "prepare": "husky",
    "start": "npm run web",
    "test": "jest --watchAll",
    "test:all": "npm run test:prettier && npm run test:types && npm run test:circular && npm run test:unit && npm run test:coverage && npm run test:integration && npm run test:e2e",
    "test:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "test:deps": "npm ls --depth=0",
    "test:dry-run": "./init.sh --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "jest --runInBand --watchAll=false tests/integration",
    "test:prettier": "prettier --check .",
    "test:smoke": "./scripts/smoke-export.sh",
    "test:security": "npm run test:deps && npm run test:unit -- src/scripts/initProcess/index.test.ts src/utils/appConfig/index.test.ts src/utils/htmlSanitizer/index.test.ts src/scripts/envParser/index.test.ts && npm run test:dry-run",
    "test:types": "tsc --skipLibCheck",
    "test:coverage": "jest --runInBand --watchAll=false --coverage src",
    "test:unit": "jest --runInBand --watchAll=false src",
    "web": "node ./scripts/sync-web-app-data.cjs && node ./scripts/generate-resume-pdf.cjs && expo start --web"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-application": "~7.0.7",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-web-browser": "~15.0.11",
    "i18next": "^25.7.1",
    "pdfkit": "^0.20.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.6.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-logs": "^5.5.0",
    "react-native-popable": "^0.4.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sanitize-html": "^2.17.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.58.2",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.18.13",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4 <21",
    "npm": ">=11.5.2 <12"
  },
  "private": true
}
