{
  "name": "about-me",
  "packageManager": "npm@11.5.2",
  "version": "2.0.0",
  "scripts": {
    "clean-install": "rm -rf node_modules && rm package-lock.json && npm install",
    "ci:local": "./scripts/ci-local.sh",
    "deploy:container": "./scripts/deploy-container.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:web": "npm run deploy:container && echo deploy:web done.",
    "export:web": "node ./scripts/sync-web-app-data.cjs && npm run ci:local && node ./scripts/sync-web-app-data.cjs && node ./scripts/generate-resume-pdf.cjs && vite build && node ./scripts/inject-web-shell.cjs",
    "fix:prettier": "prettier --write .",
    "generate:resume-pdf": "node ./scripts/generate-resume-pdf.cjs",
    "init": "./init.sh",
    "lint": "eslint ./src ./tests ./scripts --no-cache",
    "lint-fix": "eslint ./src ./tests ./scripts --fix --no-cache",
    "prepare": "husky",
    "start": "npm run web",
    "test": "jest --watchAll",
    "test:all": "npm run test:prettier && npm run test:types && npm run test:circular && npm run test:unit && npm run test:coverage && npm run test:integration && npm run test:e2e",
    "test:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "test:deps": "npm ls --depth=0",
    "test:dry-run": "./init.sh --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "jest --runInBand --watchAll=false tests/integration",
    "test:prettier": "prettier --check .",
    "test:smoke": "./scripts/smoke-export.sh",
    "test:web-bundle": "node ./scripts/assert-web-bundle.cjs dist",
    "test:security": "npm run test:deps && npm run test:unit -- src/scripts/initProcess/index.test.ts src/utils/appConfig/index.test.ts src/utils/htmlSanitizer/index.test.ts src/scripts/envParser/index.test.ts && npm run test:dry-run",
    "test:types": "tsc --skipLibCheck",
    "test:coverage": "jest --runInBand --watchAll=false --coverage src && node scripts/assert-coverage.cjs",
    "test:unit": "jest --runInBand --watchAll=false src",
    "web": "node ./scripts/sync-web-app-data.cjs && node ./scripts/generate-resume-pdf.cjs && vite"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "i18next": "^25.7.1",
    "pdfkit": "^0.20.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.6.1",
    "sanitize-html": "^2.17.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.58.2",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19.4 <21",
    "npm": ">=11.5.2 <12"
  },
  "private": true
}
